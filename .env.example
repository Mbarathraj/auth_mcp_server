# Copy to .env. Never commit .env to git.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# This SAME value must be set as MCP_API_KEY in the Django backend's .env
MCP_API_KEY=replace-me-with-a-long-random-string
HOST=127.0.0.1
PORT=8001
# Where the Django REST API lives (the MCP tools call it on behalf of the user)
DRF_BASE_URL=http://127.0.0.1:8000
