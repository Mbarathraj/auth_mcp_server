# Copy to .env. Never commit .env to git.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Google Gemini (create a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=replace-me
# Check the current model names in Google AI Studio / the Gemini API docs
GEMINI_MODEL=gemini-3.8-flash

# --- MCP server ---
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Must be EXACTLY the same value as MCP_API_KEY in the MCP server's .env
MCP_API_KEY=replace-me-with-the-mcp-servers-key
